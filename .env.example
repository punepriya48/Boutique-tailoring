# =========================================================
# PRIYA'S BOUTIQUE TAILORING - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in your actual credentials.
# =========================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (e.g., MongoDB Atlas or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/priyas_boutique

# JWT Authentication Secret Key
JWT_SECRET=priyas_boutique_secret_key_2026_super_secure

# Optional: Razorpay Payment Gateway Credentials (If integrating live payments)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Optional: WhatsApp API Business Credentials
WHATSAPP_BUSINESS_NUMBER=918446621873
